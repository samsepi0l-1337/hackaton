{
  // Cloudflare Workers 설정. 배포 전 docs/todo.md 5절(배포 선행 조건)을 확인한다.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 배포 환경: Upstage 사용 (secret UPSTAGE_API_KEY 필요). 로컬 Bun 실행은 기본 off.
  "vars": { "AI_MODE": "upstage", "AI_GATEWAY_ID": "gil-gateway", "DECIDE_ENABLED": "1" },

  // AI_MODE=route 일 때 AI Gateway 동적 라우트 dynamic/gil 호출. 로컬 dev에서도 원격 호출이다.
  "ai": { "binding": "AI" },

  // doc-worker 컨테이너 (공고 첨부 찾기·내려받기·양식 채우기)
  "containers": [
    {
      "class_name": "DocWorker",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../doc-worker/Dockerfile" } }
    }
  ],
  // GilApp: API 와 DB(SQLite KV, Zod 검사). DocWorker: 컨테이너.
  "durable_objects": {
    "bindings": [
      { "name": "APP", "class_name": "GilApp" },
      { "name": "DOC_WORKER", "class_name": "DocWorker" }
    ]
  },
  "exports": {
    "GilApp": { "type": "durable-object", "storage": "sqlite" },
    "DocWorker": { "type": "durable-object", "storage": "sqlite" }
  },

  // 웹(목업) 빌드 결과. /api/* 만 Worker 가 먼저 받는다.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
