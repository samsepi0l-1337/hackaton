{
  // Cloudflare Workers 설정. 배포 전 docs/todo.md 5절(배포 선행 조건)을 확인한다.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gil-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // 외부 AI는 기본 off (과금 0). 켜려면 AI_MODE=upstage + secret UPSTAGE_API_KEY.
  "vars": { "AI_MODE": "off", "AI_GATEWAY_ID": "gil-gateway", "DECIDE_ENABLED": "0" },

  // AI_MODE=route 일 때 AI Gateway 동적 라우트 dynamic/gil 호출. 로컬 dev에서도 원격 호출이다.
  "ai": { "binding": "AI" },

  // doc-worker 컨테이너 (공고 첨부 찾기·내려받기·양식 채우기)
  "containers": [
    {
      "class_name": "DocWorker",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "../doc-worker/Dockerfile" } }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "DOC_WORKER", "class_name": "DocWorker" }] },
  "exports": { "DocWorker": { "type": "durable-object", "storage": "sqlite" } }
}
